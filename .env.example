# Published content (see docs/content-architecture.md)
# local = static config in src/core/config (default, also the fallback when the source fails)
# neon     = reads public_api.published_content from Neon with the read-only role (production)
# postgres = same over a plain Postgres connection: the admin's local Docker (npm run dev:local sets it up)
# json     = fetches the content.<lang>.json files exported by the desktop admin
CONTENT_SOURCE=local

# neon / postgres: connection string of the web_reader role (read-only). Server only, never NEXT_PUBLIC_.
PORTFOLIO_READ_DATABASE_URL=

# json: URL with a {lang} placeholder, e.g. https://cdn.example.com/content.{lang}.json
CONTENT_JSON_URL=

# Seconds a published change may take to show up (default 60)
CONTENT_REVALIDATE_SECONDS=60

# Extra origins allowed for images published by the admin (comma separated): a host name (https) or a full
# origin such as http://localhost:9000. Add the public host of the Neon Storage images bucket.
CONTENT_IMAGE_HOSTS=

# Private buckets (Neon Storage answers 403 to public reads): the web serves the admin's files through
# /api/assets/<bucket>/<key>, signing each read. Server only, never NEXT_PUBLIC_. Ideally a read-only credential.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Buckets the route may serve, comma separated (e.g. imgs,docs)
STORAGE_BUCKETS=
