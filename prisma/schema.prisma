generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["multiSchema"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
    schemas  = ["public", "security", "projects", "configuration"]
}

model Role {
    id    Int    @id @default(autoincrement())
    name  String @unique
    users User[]

    createdAt DateTime  @default(now())
    updatedAt DateTime? @default(now())
    isDeleted Boolean   @default(false)

    @@schema("security")
}

model User {
    id       String @id @default(uuid())
    name     String
    email    String @unique
    password String
    rol      Role?  @relation(fields: [roleId], references: [id]) // one-to-many
    roleId   Int?

    createdAt DateTime  @default(now())
    updatedAt DateTime? @default(now())
    isDeleted Boolean   @default(false)

    @@schema("security")
}

model Status {
    id      String    @id @default(uuid())
    nemonic String    @unique
    project Project[]

    createdAt DateTime  @default(now())
    updatedAt DateTime? @default(now())
    isDeleted Boolean   @default(false)

    @@schema("configuration")
}

model Tag {
    id       String           @id @default(uuid())
    nemonic  String           @unique
    projects TagsOnProjects[]

    createdAt DateTime  @default(now())
    updatedAt DateTime? @default(now())
    isDeleted Boolean   @default(false)

    @@schema("projects")
}

model TagsOnProjects {
    project    Project  @relation(fields: [projectId], references: [id])
    projectId  String
    tag        Tag      @relation(fields: [tagId], references: [id])
    tagId      String
    assignedAt DateTime @default(now())

    @@id([projectId, tagId])
    @@schema("projects")
}

model Category {
    id      String    @id @default(uuid())
    nemonic String    @unique
    project Project[]

    createdAt DateTime  @default(now())
    updatedAt DateTime? @default(now())
    isDeleted Boolean   @default(false)

    @@schema("projects")
}

model Developer {
    id       String  @id @default(uuid())
    name     String
    surname  String
    github   String?
    portfoil String?
    avatar   String?

    createdAt DateTime              @default(now())
    updatedAt DateTime?             @default(now())
    isDeleted Boolean               @default(false)
    projects  DevelopersOnProject[]

    @@schema("public")
}

model Locales {
    id     Int    @id @default(autoincrement())
    locale String @unique()

    ProjectDescription      ProjectDescription[]
    ShortProjectDescription ShortProjectDescription[]
    ProjectDocumentation    ProjectDocumentation[]

    @@schema("configuration")
}

model ProjectImage {
    id  Int    @id @default(autoincrement())
    url String

    Project   Project? @relation(fields: [projectId], references: [id])
    projectId String?

    @@schema("projects")
}

model ProjectDescription {
    id    Int    @id @default(autoincrement())
    value String

    Locale    Locales? @relation(fields: [localesId], references: [id])
    localesId Int?

    Project   Project? @relation(fields: [projectId], references: [id])
    projectId String?

    @@schema("projects")
}

model ShortProjectDescription {
    id    Int    @id @default(autoincrement())
    value String

    Locale    Locales? @relation(fields: [localesId], references: [id])
    localesId Int?

    Project   Project? @relation(fields: [projectId], references: [id])
    projectId String?

    @@schema("projects")
}

model ProjectDocumentation {
    id   Int    @id @default(autoincrement())
    file String

    Locale    Locales? @relation(fields: [localesId], references: [id])
    localesId Int?

    Project   Project? @relation(fields: [projectId], references: [id])
    projectId String?

    @@schema("projects")
}

model DevelopersOnProject {
    project     Project   @relation(fields: [projectId], references: [id])
    projectId   String
    developer   Developer @relation(fields: [developerId], references: [id])
    developerId String

    assignedAt DateTime @default(now())

    @@id([projectId, developerId])
    @@schema("projects")
}

model Project {
    id               String                    @id @default(uuid())
    title            String                    @unique
    description      ProjectDescription[]
    shortDescription ShortProjectDescription[]
    logo             String
    dateStart        DateTime                  @default(now())
    dateEnd          DateTime?
    documentation    ProjectDocumentation[]
    link             String?                   @unique
    slug             String                    @unique
    images           ProjectImage[]
    Category         Category                  @relation(fields: [categoryId], references: [id])
    categoryId       String
    Status           Status                    @relation(fields: [statusId], references: [id])
    statusId         String
    tags             TagsOnProjects[]

    createdAt  DateTime              @default(now())
    updatedAt  DateTime?             @default(now())
    isDeleted  Boolean               @default(false)
    developers DevelopersOnProject[]

    @@schema("projects")
}
